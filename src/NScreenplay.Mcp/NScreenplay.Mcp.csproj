<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <RootNamespace>NScreenplay.Mcp</RootNamespace>
    <NoWarn>NU1900</NoWarn>
    <AssemblyName>NScreenplay.Mcp</AssemblyName>
    <Description>NScreenplay MCP Server — AI/agent integration layer</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NScreenplay.Core\NScreenplay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
