<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>NScreenplay.Core</RootNamespace>
    <AssemblyName>NScreenplay.Core</AssemblyName>
    <PackageId>NScreenplay.Core</PackageId>
    <Description>The core Screenplay pattern abstractions for NScreenplay: Actor, Ability, Task, Interaction, Target, Question, and Consequence. Zero external dependencies.</Description>
    <PackageTags>screenplay;test-automation;bdd;playwright;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
